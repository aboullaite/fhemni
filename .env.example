# Do not put a real key in a committed file.
GEMINI_API_KEY=replace-with-your-private-key
# Non-secret cache generation. Change this label whenever the key or its Google project changes.
GEMINI_CREDENTIAL_VERSION=local-v1
FHEMNI_ANALYTICS_ID=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FACT_CHECK_MODEL=gemini-3.8-flash
GEMINI_ANALYSIS_MAX_OUTPUT_TOKENS=16384
GEMINI_CONTEXT_MAX_OUTPUT_TOKENS=16384
GEMINI_QUESTION_MAX_OUTPUT_TOKENS=16384
GEMINI_FACT_CHECK_MAX_OUTPUT_TOKENS=8192

# Party-programme feasibility: gemini, openai, or consensus.
# OpenAI is used only for this workflow; video analysis and chat remain Gemini.
FHEMNI_PROGRAMME_FACT_CHECK_MODE=gemini
OPENAI_API_KEY=
OPENAI_PROGRAMME_FACT_CHECK_MODEL=gpt-5.6-terra
OPENAI_PROGRAMME_FACT_CHECK_TIMEOUT=PT15M
OPENAI_PROGRAMME_FACT_CHECK_MAX_OUTPUT_TOKENS=32768

# Optional passwordless login providers. Leave blank to run without login links.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Bootstrap yourself as admin with either a trusted provider subject
# (for example google:123456789) or a verified Google account email.
FHEMNI_ADMIN_IDENTITIES=
FHEMNI_BOOTSTRAP_ADMIN_EMAIL=

# Optional PostgreSQL settings. Local development defaults to an embedded H2 file.
JDBC_DATABASE_URL=
JDBC_DATABASE_USERNAME=
JDBC_DATABASE_PASSWORD=
JDBC_MAX_POOL_SIZE=5
JDBC_MIN_IDLE=1
FHEMNI_LOGIN_SESSION_TIMEOUT=8h

# Optional operational limits
GEMINI_ANALYSIS_TIMEOUT=PT12M
GEMINI_QUESTION_TIMEOUT=PT30S
GEMINI_FACT_CHECK_TIMEOUT=PT90S
YOUTUBE_OEMBED_TIMEOUT=PT5S
FHEMNI_MAX_SESSIONS=250
FHEMNI_SESSION_RETENTION=PT6H
FHEMNI_CLEANUP_INTERVAL_MS=300000
FHEMNI_MAX_CONVERSATION_TURNS=10
FHEMNI_MAX_PROVIDER_CONVERSATION_TURNS=5
FHEMNI_MAX_USER_CONVERSATIONS=1000
FHEMNI_MAX_SUBSCRIBERS=16
FHEMNI_CATALOG_IMPORT_CONCURRENCY=3
FHEMNI_CATALOG_PEOPLE_MAX_COMPARISONS=20
FHEMNI_CATALOG_PEOPLE_CACHE_TTL=PT60S
FHEMNI_CATALOG_BATCH_ANALYSIS_TIMEOUT=PT30M
# Enable only during the one-off admin migration after a Gemini key/project change.
FHEMNI_CONTEXT_MIGRATION_ENABLED=false
FHEMNI_SUGGESTION_LIMIT=10
FHEMNI_SUGGESTION_WINDOW=PT1H
FHEMNI_SUGGESTION_MAX_CLIENTS=10000
FHEMNI_ANALYSIS_ENABLED=true
FHEMNI_CHAT_ENABLED=false
FHEMNI_ANALYSIS_CONCURRENCY=1
FHEMNI_ANALYSIS_QUEUE_CAPACITY=2
# Set to 0 only for owner-controlled local catalogue generation.
FHEMNI_MAX_DAILY_ANALYSES=5
FHEMNI_MAX_HOURLY_CHAT_ROUNDS=50
FHEMNI_MAX_DAILY_CHAT_ROUNDS=500
FHEMNI_MAX_WEEKLY_CHAT_ROUNDS_PER_USER=5
FHEMNI_MAX_DAILY_CHAT_OUTPUT_TOKENS_PER_USER=10000
