# Non-secret container settings. Credentials belong in the ignored .secrets
# directory described in docs/CONTAINERS.md.
POSTGRES_DB=fhemni
POSTGRES_USER=fhemni
POSTGRES_INITDB_ARGS=--auth-host=scram-sha-256
JDBC_DATABASE_URL=jdbc:postgresql://database:5432/fhemni
JDBC_DATABASE_USERNAME=fhemni
JDBC_MAX_POOL_SIZE=5
JDBC_MIN_IDLE=1
FHEMNI_LOGIN_SESSION_TIMEOUT=8h

GEMINI_MODEL=gemini-3.8-flash
GEMINI_FACT_CHECK_MODEL=gemini-3.8-flash
GEMINI_CREDENTIAL_VERSION=container-v1
GEMINI_ANALYSIS_MAX_OUTPUT_TOKENS=16384
GEMINI_CONTEXT_MAX_OUTPUT_TOKENS=16384
GEMINI_QUESTION_MAX_OUTPUT_TOKENS=16384
GEMINI_FACT_CHECK_MAX_OUTPUT_TOKENS=8192
FHEMNI_PROGRAMME_FACT_CHECK_MODE=gemini
# Required by compose.yaml; credentials stay in the ignored .secrets directory.
FHEMNI_PROGRAMME_MEDIA_GCS_PROJECT=
FHEMNI_PROGRAMME_MEDIA_GCS_BUCKET=
FHEMNI_PROGRAMME_MEDIA_ILLUSTRATIONS_ENABLED=true
FHEMNI_PROGRAMME_MEDIA_TTS_VOICE=Charon
FHEMNI_PROGRAMME_MEDIA_TTS_SECONDARY_VOICE=Kore
FHEMNI_PROGRAMME_MEDIA_PROVIDER_CONCURRENCY=4
OPENAI_PROGRAMME_FACT_CHECK_MODEL=gpt-5.6-terra
OPENAI_PROGRAMME_FACT_CHECK_TIMEOUT=PT15M
OPENAI_PROGRAMME_FACT_CHECK_MAX_OUTPUT_TOKENS=32768

FHEMNI_ANALYSIS_ENABLED=false
FHEMNI_CHAT_ENABLED=false
FHEMNI_ANALYSIS_CONCURRENCY=1
FHEMNI_ANALYSIS_QUEUE_CAPACITY=2
FHEMNI_MAX_DAILY_ANALYSES=5
FHEMNI_MAX_HOURLY_CHAT_ROUNDS=50
FHEMNI_MAX_DAILY_CHAT_ROUNDS=500
FHEMNI_MAX_DAILY_CHAT_ROUNDS_PER_USER=20
FHEMNI_MAX_WEEKLY_CHAT_ROUNDS_PER_USER=100
FHEMNI_MAX_DAILY_CHAT_OUTPUT_TOKENS_PER_USER=16000
FHEMNI_MAX_CONVERSATION_TURNS=10
FHEMNI_MAX_PROVIDER_CONVERSATION_TURNS=5
GEMINI_QUESTION_TIMEOUT=PT30S
FHEMNI_CATALOG_IMPORT_CONCURRENCY=3
FHEMNI_CONTEXT_MIGRATION_ENABLED=false
FHEMNI_SUGGESTION_LIMIT=10
FHEMNI_SUGGESTION_WINDOW=PT1H
FHEMNI_SUGGESTION_MAX_CLIENTS=10000

FHEMNI_ANALYTICS_ID=
# Discord OAuth redirect: https://fhemni.ma/login/oauth2/code/discord
# Put the Discord client ID and secret in .secrets, not in this file.
FHEMNI_MAGIC_LINK_ENABLED=false
FHEMNI_PUBLIC_BASE_URL=https://fhemni.ma
FHEMNI_MAIL_FROM='Fhemni.ma <noreply@fhemni.ma>'
FHEMNI_MAGIC_LINK_LIFETIME=PT15M
FHEMNI_MAGIC_LINK_REQUEST_LIMIT=10
FHEMNI_MAGIC_LINK_REQUEST_WINDOW=PT1H
FHEMNI_MAGIC_LINK_MAX_CLIENTS=10000
# API key belongs in .secrets/mailgun_api_key.
FHEMNI_MAILGUN_DOMAIN=fhemni.aboullaite.me
# fhemni.aboullaite.me is configured in Mailgun's US region.
FHEMNI_MAILGUN_BASE_URL=https://api.mailgun.net
FHEMNI_MAILGUN_TIMEOUT=PT10S
FHEMNI_BOOTSTRAP_ADMIN_EMAIL=
